{
  "name": "@sarchauhan/chat",
  "version": "0.1.0",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.mjs",
      "require": "./dist/widgets.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.6",
    "@fontsource/geist-sans": "^5.2.6",
    "@sarchauhan/adapter": "0.0.1",
    "@sarchauhan/code-markdown": "^0.0.3",
    "@sarchauhan/protocol": "0.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "radix-ui": "^1.4.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "description": "Embeddable React chat UI, streaming runtime, and prebuilt agent widgets.",
  "sideEffects": [
    "**/*.css"
  ]
}
